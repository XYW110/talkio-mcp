# ==========================================================================
# talkio-mcp-expert-council API 密钥模板
#
# 用法：复制本文件为 .env 并填入真实密钥。
#   - .env 已被 .gitignore 忽略，切勿提交真实密钥到仓库。
#   - experts.json 中每个 provider 通过 apiKeyEnv 字段间接引用这里的环境变量名，
#     配置文件本身绝不存放真实密钥。
#   - 只需为实际用到的 provider 配置密钥；缺失密钥的 provider 会在调用对应专家时
#     报 "missing env var" 错误，但不影响其他专家正常返回。
# ==========================================================================

# ── 管理后台鉴权（SSE 模式必需）──────────────────────────────
# 管理后台登录令牌；未设置时 fail-closed：/api/*、/sse、/messages 全部 401。
# 请替换为强随机字符串（如 openssl rand -hex 24 生成）。轮换 = 改值 + 重启。
TALKIO_ADMIN_TOKEN=change-me-to-a-long-random-string

# （可选）MCP 访问令牌存储路径覆盖；默认 experts.json 同目录 mcp-tokens.json
# TALKIO_MCP_TOKENS_FILE=/path/to/mcp-tokens.json

# ── LLM Provider API 密钥 ────────────────────────────────────
# OpenAI（type: openai）——https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic Claude（type: anthropic）——https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# DeepSeek（type: openai-compatible）——https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 专家记忆目录（缺省 <experts.json 所在目录>/memory）
# TALKIO_MEMORY_DIR=/path/to/memory
