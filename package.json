{
  "name": "talkio-mcp-expert-council",
  "version": "0.2.0",
  "description": "MCP server providing expert-council consultation (consult_experts) and multi-round brainstorm tools backed by configurable AI providers",
  "type": "module",
  "bin": {
    "talkio-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "experts.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build:web": "npm --prefix admin-web run build",
    "dev:web": "npm --prefix admin-web run dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
